{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Antiforgery": "Error",
      "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "None",
      "Microsoft.EntityFrameworkCore": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": false,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ",
        "UseUtcTimestamp": true
      }
    }
  },
  "AllowedHosts": "*",
  "Auth": {
    "MinPasswordLength": 12,
    "MaxFailedLogins": 5,
    "LockoutMinutes": 15,
    "SessionHours": 12,
    "VerificationTokenHours": 24
  },
  "RateLimits": {
    "LoginPerMinute": 20,
    "SignupPerMinute": 5,
    "WebhookPerMinute": 120,
    "ApiPerMinute": 600
  },
  "Outbox": {
    "BatchSize": 20,
    "PerTenantBatch": 5,
    "MaxAttempts": 8
  },
  "Seed": {
    "Enabled": false
  },
  "Billing": {
    "Simulation": {
      "Enabled": false,
      "AllowOutcomeSelection": false
    }
  }
}
