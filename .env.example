# Kulvar yerel yığını — isteğe bağlı ortam değişkenleri (compose.yaml bunları okur).
# Bu dosya yalnız ÖRNEKTİR ve sır içermez. Normalde gerek yoktur: scripts/local-stack.ps1 | .sh bu değerleri kendisi ayarlar.
# Elle `docker compose` çalıştıracaksanız `.env` olarak kopyalayın (.env git'e girmez).
#
# Sırlar burada DURMAZ. Parolalar, bağlantı dizeleri, webhook sırrı ve sertifika `local-stack init` ile
# KULVAR_LOCAL_DIR altında rastgele üretilir ve kapsayıcılara Docker secret dosyası olarak bağlanır.

# Yerel sır/sertifika/demo parola dizini (git'e girmez).
KULVAR_LOCAL_DIR=./.local

# HTTPS portu (yalnız 127.0.0.1'e bağlanır).
KULVAR_HTTPS_PORT=8843

# Ortam adı. Development dışında: demo seed ve ödeme simülasyonu başlangıç korumalarıyla REDDEDİLİR.
KULVAR_ENVIRONMENT=Development

# Simüle ödeme sonucunu seçme ve sağlayıcı olayı tetikleme (yalnız Development; varsayılan kapalı).
KULVAR_SIMULATION=false

# IP başına hız sınırları (istek/dakika).
KULVAR_LOGIN_LIMIT=20
KULVAR_SIGNUP_LIMIT=5
